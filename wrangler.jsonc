{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dvbh-suite",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dvbh-db",
      "database_id": "8246172f-1c30-4436-a922-1aad578a0b53",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": ["0 20 * * *", "0 * * * *"]
  },

  "vars": {
    "BOOTSTRAP_ADMIN_EMAIL": "smarttrade.vp@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://dvbh-suite.ongtho.workers.dev/api/auth/callback",
    "FRONTEND_URL": "https://dvbh-suite.ongtho.workers.dev"
  }
}
