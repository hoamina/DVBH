{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dvbh",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],

  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dvbh-db-smarttrade",
      "database_id": "d47ee3fa-3796-4814-a0dc-3ce2a7628c82",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "dvbh-reports-smarttrade"
    }
  ],

  "triggers": {
    "crons": ["0 20 1 * *", "0 2,6,9 * * *", "0 1 * * *", "30 10 * * *"]
  },

  // Them 2026-09-11: "VIPHAM_APP" - Service Binding toi Worker "vipham" (Giai trinh vi pham). Bat
  // buoc dung binding (KHONG fetch() thang URL) - "dvbh" va "vipham" cung 1 tai khoan Cloudflare,
  // fetch() thang bi chan loi 1042 (chong SSRF Worker-to-Worker), giong linh-kien-app da gap voi
  // CASE_LOOKUP_SERVICE. "service" la ten SCRIPT that ("vipham" trong wrangler.jsonc cua repo do), suy
  // tu domain "vipham.dichvu3t.workers.dev".
  "services": [{ "binding": "VIPHAM_APP", "service": "vipham" }],

  "vars": {
    "BOOTSTRAP_ADMIN_EMAIL": "smarttrade.vp@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://dvbh.dichvu3t.workers.dev/api/auth/callback",
    "FRONTEND_URL": "https://dvbh.dichvu3t.workers.dev",
    // URL cua Worker "vipham" - van giu de dung lam Request URL truyen vao VIPHAM_APP.fetch() (binding
    // chi doi huong mang, phan pathname van do Hono ben nhan tu doc). VIPHAM_APP_API_KEY dat qua
    // "wrangler secret put" (da dat).
    "VIPHAM_APP_URL": "https://vipham.dichvu3t.workers.dev"
  }
}
